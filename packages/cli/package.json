{
  "name": "rivelle",
  "version": "0.1.0",
  "description": "Ownable, shadcn-compatible UI components for React and Next.js.",
  "homepage": "https://rivelle.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3cproject/rivelle-ui.git",
