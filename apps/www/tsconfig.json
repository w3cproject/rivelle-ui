{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["../../registry/nova/ui/*"],
      "@/components/blocks/*": ["../../registry/nova/blocks/*"],
      "@/effects/*": ["../../registry/nova/effects/*"],
      "@/blocks/*": ["../../registry/nova/blocks/*"],
      "@/templates/*": ["../../registry/nova/templates/*"],
      "@/lib/utils": ["../../registry/nova/lib/utils.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
